datasource db{
    provider = "mysql"
}

model User{
    id Int @id @default(autoincrement())
    name String
    email String @unique
    password String
    documentoId Int @unique
    postJob String
    veryfyEmail Boolean @default(false)
    active Boolean @default(true)
    roleId Int
}

model role{
    id Int @id @default(autoincrement())
    name String
}